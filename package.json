{
  "name": "nova64",
  "version": "0.5.1",
  "description": "Nova64 — Ultimate 3D Fantasy Console runtime for JavaScript games powered by Three.js",
  "keywords": [
    "fantasy-console",
    "3d",
    "game-engine",
    "threejs",
    "retro",
    "games"
  ],
  "license": "MIT",
  "author": "Nova64 Contributors",
  "homepage": "https://github.com/seacloud9/nova64#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seacloud9/nova64.git"
  },
  "bugs": {
    "url": "https://github.com/seacloud9/nova64/issues"
  },
  "type": "module",
  "bin": {
    "nova64": "./bin/nova64.js"
  },
  "main": "./runtime/index.js",
  "types": "./runtime/index.d.ts",
  "exports": {
    ".": {
      "types": "./runtime/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./runtime/*": "./runtime/*.js",
    "./runtime/api-3d/*": "./runtime/api-3d/*.js",
    "./runtime/ui/*": "./runtime/ui/*.js"
  },
  "files": [
    "bin/",
    "dist/",
    "runtime/",
    "src/",
    "public/",
    "index.html",
    "vite.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.js",
    "preview": "vite preview",
    "osBuild": "cd os9-shell && pnpm install && pnpm build && rm -rf ../public/os9-shell/* && mkdir -p ../public/os9-shell && cp -r dist/* ../public/os9-shell/",
    "osMobileDev": "cd os9-shell && pnpm dev",
    "osMobileBuild": "cd os9-shell && pnpm install && pnpm build && rm -rf ../public/os9-shell/* && mkdir -p ../public/os9-shell && cp -r dist/* ../public/os9-shell/",
    "deployToStarcade9": "bash scripts/deploy-starcade9.sh",
    "serveStarcade9": "npx serve ../starcade9/starcade9.github.io",
    "test": "node tests/test-cli.js",
    "test:api": "node tests/test-cli.js api",
    "test:input": "node tests/test-cli.js input",
    "test:starfox": "node tests/test-cli.js starfox",
    "test:integration": "node tests/test-cli.js integration",
    "test:voxel": "node tests/test-cli.js voxel",
    "test:resize": "node tests/test-cli.js resize",
    "test:cli": "node tests/test-cli.js cli",
    "test:namespace": "node tests/test-namespace.js",
    "mempalace:mine": "wsl bash -c 'cd ~/ai-tools && pipenv run mempalace mine /mnt/c/Users/brend/exp/nova64/runtime/ --mode projects --wing nova64_runtime'",
    "mempalace:search": "wsl bash -c 'cd ~/ai-tools && pipenv run mempalace search'",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov --report-dir=coverage --include='runtime/**/*.js' node tests/test-cli.js",
    "test:coverage:summary": "c8 --reporter=text-summary --include='runtime/**/*.js' node tests/test-cli.js",
    "test:web": "open tests/test-runner.html || xdg-open tests/test-runner.html || start tests/test-runner.html",
    "test:all": "pnpm run test && pnpm run test:api && pnpm run test:input && pnpm run test:starfox && pnpm run test:integration",
    "test:watch": "nodemon --watch runtime --watch tests --watch examples --exec 'pnpm run test'",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:debug": "playwright test --debug",
    "test:babylon": "playwright test tests/playwright/backend-parity.spec.js",
    "test:babylon:ui": "playwright test tests/playwright/backend-parity.spec.js --ui",
    "test:babylon:api": "playwright test tests/playwright/api-compatibility.spec.js",
    "test:babylon:perf": "playwright test tests/playwright/performance-comparison.spec.js",
    "test:babylon:visual": "playwright test tests/playwright/visual-regression.spec.js",
    "test:babylon:gameplay": "playwright test tests/playwright/space-harrier-gameplay.spec.js",
    "test:start-screen": "playwright test tests/playwright/start-screen.spec.js",
    "test:babylon:all": "playwright test tests/playwright/",
    "godot:visual": "node nova64-godot/scripts/visual-parity.js --all --report-only",
    "test:godot:visual": "node nova64-godot/scripts/visual-parity.js --all --fail-on-threshold",
    "bench": "node tests/bench.js",
    "bench:material": "node tests/bench.js --suite=material",
    "bench:instancing": "node tests/bench.js --suite=instancing",
    "bench:mesh": "node tests/bench.js --suite=mesh",
    "lint": "eslint 'runtime/**/*.js' 'src/**/*.js' --max-warnings=0",
    "lint:fix": "eslint 'runtime/**/*.js' 'src/**/*.js' --fix",
    "lint:godot": "eslint 'nova64-godot/godot_project/carts/**/*.js'",
    "lint:godot:fix": "eslint 'nova64-godot/godot_project/carts/**/*.js' --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run test:all",
    "clean": "rm -rf dist node_modules",
    "reinstall": "pnpm run clean && pnpm install",
    "prepare": "husky",
    "prepublishOnly": "pnpm run validate && pnpm run build",
    "release:patch": "pnpm version patch && git push && git push --tags",
    "release:minor": "pnpm version minor && git push && git push --tags",
    "release:major": "pnpm version major && git push && git push --tags"
  },
  "dependencies": {
    "@babylonjs/core": "^9.4.1",
    "@inquirer/prompts": "^8.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.182.0",
    "vite": "^5.4.0",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "noa-engine": "^0.33.0"
  },
  "peerDependencies": {
    "noa-engine": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "noa-engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.8",
    "@playwright/test": "^1.59.1",
    "c8": "^10.1.3",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.10",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "terser": "^5.46.0"
  },
  "lint-staged": {
    "runtime/**/*.js": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "src/**/*.js": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "examples/**/*.js": [
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "no-console": "off",
      "no-undef": "warn"
    },
    "globals": {
      "THREE": "readonly",
      "nova64": "readonly"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "arrowParens": "avoid"
  }
}
