#!/usr/bin/env bash
# Verify GitHub CI will pass BEFORE pushing. Committing locally never triggers
# CI, so a push is the right gate:
#   • pushing a branch  → ci.yml (test + build)           → runs `pnpm ci:check`
#   • pushing a v* tag  → publish.yml (npm) + release-cores → runs `--release`
#     (lint blocking, test:all, npm publish --dry-run, version-not-published)
# See scripts/ci-preflight.mjs. Bypass (WIP/emergency):  git push --no-verify
# Ensure the repo Node (.nvmrc) / pnpm are on PATH regardless of shell environment.
# Use the repo's Node (.nvmrc) when nvm is installed; otherwise keep PATH as-is.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" --no-use
  nvm use --silent >/dev/null 2>&1 || true
fi

# Detect whether any pushed ref is a version tag (stdin: <localref> <sha> <remoteref> <sha>).
pushing_release_tag=0
while read -r localref localsha remoteref remotesha; do
  case "$remoteref" in
    refs/tags/v*) pushing_release_tag=1 ;;
  esac
done

if [ "$pushing_release_tag" = "1" ]; then
  echo "→ Release tag detected — running full npm/release preflight (pnpm ci:check --release)"
  pnpm run ci:check -- --release
else
  pnpm run ci:check
fi
