git s https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# secrets and enviorment variables 
# .env
# dependencies
/screenshots
/node_modules
/os9-shell/node_modules
/os9-shellMobile/node_modules
# server deps live on ext4 (WSL home) + are symlinked in; never commit the link.
# colyseus 0.17 is ESM-only and pnpm's atomic renames fail on /mnt/c — see
# server/.npmrc and the install workaround in docs/MULTIPLAYER_AND_AUTH_DESIGN.md.
server/node_modules
/dist
/.pnp
.pnp.js
os9-shell/node_modules
os9-shellMobile/node_modules
# testing
/coverage
/.nyc_output
/playwright-report
/tmp/
/.playwright-mcp/
/.claude/scheduled_tasks.lock
/test-results
/testout.txt
/c8out.txt

# production
/build
/retroarch/build/
/retroarch/games_old/
/retroarch/*.a
/retroarch/*.dll
/retroarch/*.dylib
/retroarch/*.o
/retroarch/*.os
/retroarch/*.so
/.sconsign.dblite
/nova64-godot/gdextension/third_party/quickjs/*.o
/nova64-godot/gdextension/third_party/quickjs/*.os
/nova64-godot/gdextension/third_party/quickjs/
# Godot carts are local Windows junctions into examples/ (created by
# `pnpm godot <cart>` / scripts/godot-play.mjs). The cart content is tracked in
# examples/, so the junctions themselves must NOT be tracked — git can't stash
# "beyond" them, which breaks the lint-staged pre-commit hook.
/nova64-godot/godot_project/carts/*
!/nova64-godot/godot_project/carts/.gitkeep
/nova64-godot/godot_project/addons/colyseus/bin/~*
/nova64-godot/godot_project/addons/colyseus/bin/*.TMP

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# commit messages
COMMIT_MESSAGE.txt

# old patch scripts
scripts/old-patches/

# Local reference projects used for ports and analysis
/refrence/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# WAD files (large binary game data)
*.wad

# Godot shader examples and assets (Jettelly course - don't commit)
nova64-godot/godot_project/data/

# Godot user assets directory (GLB models, VOX files, etc.)
nova64-godot/godot_project/assets/

# MemPalace generated entity registry (issue #185)
entities.json

# Local RetroArch cart save data (storage + highscore JSON written by the core)
/nova64/

# Video source binaries — the web demo's sample .mp4 is a large external asset,
# not tracked. Fetch/transcode locally; native carts ship their own .mpg/.ogv.
*.mp4
