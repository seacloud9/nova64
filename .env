# Nova64 dev config — single source of truth for the multiplayer endpoint.
#
# Godot (native Windows) must use the IPv4 loopback 127.0.0.1: `localhost`
# resolves to IPv6 ::1, which does NOT traverse WSL mirrored networking. The web
# client derives its URL from the page host automatically and ignores this.
#
# Consumed by: scripts/godot.sh (Godot launch URL) and the server (PORT).
NOVA64_NET_URL=ws://127.0.0.1:2567
PORT=2567
