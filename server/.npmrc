# pnpm on a Windows-mounted path (/mnt/c) fails atomic renames (EACCES); copy +
# a flat node_modules avoids the hardlink/rename dance. shamefully-hoist flattens
# ALL transitive deps to the top level, which colyseus 0.17 (ESM) needs since it
# imports several deps (@colyseus/msgpackr, etc.) directly.
node-linker=hoisted
package-import-method=copy
shamefully-hoist=true
